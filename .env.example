# Copy to .env. Use unique credentials; never commit .env.
POSTGRES_USER=cft_agent
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
CLIENT_TOKEN_SECRET=CHANGE_TO_A_DIFFERENT_RANDOM_SECRET_32CHARS_MIN
POSTGRES_DB=cft_agent
POSTGRES_PORT=5432

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_chunks_e5_large_v2

# DeepSeek API is used only for answer generation.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENT=4
LLM_CIRCUIT_BREAKER_FAILURES=3
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=20

# Local multilingual dense embeddings via FastEmbed + ONNX Runtime (CPU; no API key).
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_THREADS=2

APP_ENV=production
APP_NAME=CFT Knowledge Assistant API
APP_VERSION=1.6.1-cft-rag-hardening
API_PREFIX=/api
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SESSION_TTL_HOURS=24
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.005
RAG_ENABLED=true

# Website crawling. Only cft.ru and its subdomains are crawled by default; external domains require explicit approval.
CRAWL_START_URLS=https://www.cft.ru/
CRAWL_MAX_PAGES=300
CRAWL_MAX_DEPTH=2
CRAWL_ALLOWED_DOMAINS=cft.ru
CRAWL_APPROVED_EXTERNAL_DOMAINS=
CRAWL_DOWNLOAD_TIMEOUT=30
CRAWL_MAX_DOWNLOAD_MB=25
CRAWL_CONCURRENT_REQUESTS=6
CRAWL_CONCURRENT_PER_DOMAIN=2
CRAWL_DOWNLOAD_DELAY=1.0
CRAWL_LOG_LEVEL=INFO
FRONTEND_PORT=8080
